# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Redis
REDIS_URL=redis://HOST:PORT

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# TMDB
TMDB_API_KEY=your-tmdb-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Google OAuth (Server-Side Code Exchange & ID Token Verification)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URI: https://cine-vault-gules.vercel.app/auth/google/callback (prod) or http://localhost:3000/auth/google/callback (dev)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend)
# Use CineVault <onboarding@resend.dev> for sandbox testing (only delivers to the Resend account owner email).
# For sending to arbitrary users in production, verify a custom domain in Resend and use CineVault <noreply@yourdomain.com>.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=CineVault <onboarding@resend.dev>

# App URLs
# In production Render, FRONTEND_URL must be set to https://cine-vault-gules.vercel.app
APP_URL=http://localhost:3000
FRONTEND_URL=https://cine-vault-gules.vercel.app
API_URL=http://localhost:4000
