# API and App URLs
# In production Vercel, NEXT_PUBLIC_API_URL=https://cinevault-api-r05f.onrender.com/api/v1
# NEXT_PUBLIC_APP_URL=https://cine-vault-gules.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Client ID (Public identifier only — NEVER put client secrets in NEXT_PUBLIC_*)
# Configured in Vercel Project Settings -> Environment Variables
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# TMDB API (https://www.themoviedb.org/settings/api)
# This is SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here


